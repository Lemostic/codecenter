{
  "name": "@mdm/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./src/types/index.ts",
    "./types/*": "./src/types/*",
    "./config": "./src/config/index.ts",
    "./config/types": "./src/config/types.ts",
    "./config/apply": "./src/config/apply.ts",
    "./config/providers/static": "./src/config/providers/static.ts",
    "./auth": "./src/auth/index.ts",
    "./http": "./src/http/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./i18n/utils": "./src/i18n/utils.ts",
    "./router": "./src/router/index.ts",
    "./layout": "./src/layout/AppLayout.vue",
    "./layout/*": "./src/layout/*",
    "./stores/*": "./src/stores/*"
  },
  "scripts": {
    "build": "vue-tsc --noEmit && node build-dist.mjs",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "axios": "^1.7.9",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-i18n": "^9.13.1",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "axios": "^1.7.9",
    "pinia": "^2.2.6",
    "typescript": "^5.6.3",
    "vue": "^3.5.13",
    "vue-i18n": "^9.13.1",
    "vue-router": "^4.4.5",
    "vue-tsc": "^2.1.10"
  }
}
