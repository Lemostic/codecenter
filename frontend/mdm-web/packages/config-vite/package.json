{
  "name": "@mdm/config-vite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./mock": {
      "types": "./src/mock.ts",
      "import": "./dist/mock.js"
    }
  },
  "scripts": {
    "build": "vue-tsc --noEmit && node build-dist.mjs",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "unplugin-auto-import": "^0.18.6",
    "unplugin-vue-components": "^0.27.5"
  },
  "peerDependencies": {
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
